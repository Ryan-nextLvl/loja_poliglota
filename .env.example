# Copie para .env e preencha. O .env NÃO vai para o Git.

PORT=3000
NOME_LOJA=Loja Poliglota

# WhatsApp que recebe os pedidos: só dígitos, com DDI+DDD (ex.: 5511999998888)
WHATSAPP_NUMBER=

# Supabase (Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=

# E-mails autorizados como administrador, separados por vírgula.
# Se vazio, qualquer usuário autenticado no Supabase é admin (desative o sign-up!).
ADMIN_EMAILS=

# MongoDB Atlas (Connect > Drivers) ou local: mongodb://localhost:27017
MONGODB_URI=
MONGODB_DB=loja

# Redis (Memurai/Redis local, ou Upstash/Redis Cloud)
REDIS_URL=redis://localhost:6379
